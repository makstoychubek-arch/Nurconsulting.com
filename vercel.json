{
  "buildCommand": "npm install --include=dev && npm run build && rm -rf node_modules frontend/node_modules",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'; base-uri 'self'; object-src 'none'" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" }
      ]
    },
    {
      "source": "/dashboard.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/nr-auth.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/(space|logistics|ab-testing|advertising|seo|marking|rnp|telegram-bots|ozon|agents|analytics|goods|content|reports)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/img/(.*)\\.webp",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/dist/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/manifest.json",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ],
  "rewrites": [
    { "source": "/mcp/:key", "destination": "https://fiukyfyhotctvfdidktx.supabase.co/functions/v1/mcp/:key" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/reset-password", "destination": "/reset-password.html" },
    { "source": "/space", "destination": "/dashboard.html" },
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/rnp", "destination": "/dashboard.html" },
    { "source": "/goods", "destination": "/dashboard.html" },
    { "source": "/content", "destination": "/dashboard.html" },
    { "source": "/cabinets", "destination": "/dashboard.html" },
    { "source": "/reports", "destination": "/dashboard.html" },
    { "source": "/ab-testing", "destination": "/dashboard.html" },
    { "source": "/advertising", "destination": "/dashboard.html" },
    { "source": "/seo", "destination": "/dashboard.html" },
    { "source": "/marking", "destination": "/dashboard.html" },
    { "source": "/logistics", "destination": "/dashboard.html" },
    { "source": "/telegram-bots", "destination": "/dashboard.html" },
    { "source": "/ozon", "destination": "/dashboard.html" },
    { "source": "/agents", "destination": "/dashboard.html" },
    { "source": "/analytics", "destination": "/dashboard.html" },
    { "source": "/rnp-app", "destination": "/rnp-app/index.html" },
    { "source": "/rnp-app/:path*", "destination": "/rnp-app/:path*" },
    { "source": "/marking-app/:path*", "destination": "/marking-app/:path*" },
    { "source": "/consulting", "destination": "/consulting.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/consent", "destination": "/consent.html" },
    { "source": "/", "destination": "/index.html" }
  ]
}
