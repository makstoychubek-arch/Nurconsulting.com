# ── Telegram team agents (telegram-router) ─────────────────────────────
# Секреты реально кладутся в Supabase Function Secrets, не в git.
# Этот файл — справочник переменных.

# Модель для свободного team plan / hop-диалога (по умолчанию gpt-4o)
OPENAI_MODEL=gpt-4o

# Модель для лёгких/структурированных сценариев (если путь вызывает askOpenAI
# с modelKind="fast" или modelOverride). Сейчас /sales /ads /fbs /selfbuy,
# pending РК и FBS-кнопки OpenAI не вызывают — переменная зарезервирована
# и готова к использованию без смены дефолта для команды.
AGENT_FAST_MODEL=gpt-4o-mini

# Отдельный мозг CRM Алины (alina-brain.ts) — не конфликтует с AGENT_FAST_MODEL
# ALINA_BRAIN_MODEL=gpt-4o-mini

OPENAI_API_KEY=

# ── Кэш WB-фактов (agent-wb-context.ts), isolate in-memory ─────────────
# TTL в мс (по умолчанию 90000 = 90 сек). 0 = выключить кэш.
WB_CONTEXT_TTL_MS=90000
# Явный выключатель кэша (1/true) — откат одной переменной
# DISABLE_WB_CONTEXT_CACHE=1

# ── Утреннее приветствие (agent-morning-greeting-runner) ───────────────
# Сколько агентов максимум в утренней цепочке (стартер + реакции), дефолт 3.
# Не связано с AGENT_CHAT_MAX_HOPS.
MORNING_GREETING_MAX_HOPS=3
# Модель старта/реакций — AGENT_FAST_MODEL (gpt-4o-mini). Погода: open-meteo.com
